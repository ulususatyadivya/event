rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      // Role cannot be self-assigned or changed by a student.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && registrationId == request.auth.uid + '_' + request.resource.data.eventId;
      allow update, delete: if isAdmin();
    }

    // Reservation docs are only readable/writable by signed-in users to support
    // client-side uniqueness transactions. For high-stakes deployment, replace
    // this with a trusted Cloud Function and stricter server-side validation.
    match /uniqueEmails/{key} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }
    match /uniqueRollNumbers/{key} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }
  }
}